
<% layout('/layouts/boilerplate') -%>

    <!-- <form method="get" action="/listings/new">
      <button>Create new lsiting</button>
    </form> -->
    <h3>All Listings</h3>
    <div class="row row-cols-lg-3 row-cols-md-2 row-cols-sm-1">
    <% for( listing of allListing){ %>
      <a href="/listings/<%= listing._id  %>  " class="listing-links">
    <div class="card col" >
  <img src="<%= listing.image  %>" class="card-img-top" alt="listing_image" style="height: 20rem;">
  <div class="card-img-overlay">abs</div>
  <div class="card-body">
    <b><p class="card-text"><%= listing.title  %> </b> <br>
&#8377;<%= listing.price.toLocaleString("en-IN")%> / night    </p>
  </div>
</div>
</a>
<%}%>
</div>
