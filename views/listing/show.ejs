<% layout('/layouts/boilerplate') -%>

  <div class="row">
    <div class="col-8 mt-3 offset-3">
      <h3>
        <%= listing.title %>
      </h3>
    </div>

    <div class="card col-6 offset-3 show-card">
      <img src="<%= listing.image %>" class="card-img-top show-img" alt="listing_image" />

      <div class="card-body">
        <p class="card-text">
          <%= listing.description %><br /><br />

            &#8377;<%= listing.price ? listing.price.toLocaleString("en-IN") : "N/A" %><br />

              <%= listing.location %><br />

                <%= listing.country %>
        </p>
      </div>
    </div>

    <div class="col-6 offset-3 mt-3 mb-3">
      <a href="/listings/<%= listing._id %>/edit" class="btn btn-dark edit-btn">
        Edit
      </a>

      <form method="post" action="/listings/<%= listing._id %>?_method=DELETE" class="d-inline">
        <button class="btn btn-danger">Delete</button>
      </form>
      <hr />
    </div>
    <!-- REVIEW FORM -->
    <div class="col-6 mt-3 offset-3 mb-3 needs-validation" novalidate>
      <h4>Leave a Review</h4>

      <form action="/listings/<%= listing._id %>/reviews" method="POST" class="needs-validation">
        <div class="mb-3 mt-3">
          <label for="rating" class="form-label">Rating</label>
          <input type="range" min="1" max="5" id="rating" name="rating" class="form-range" required value="3" />
        </div>

        <div class="mb-3 mt-3">
          <label for="comment" class="form-label">Comments</label>
          <textarea name="comment" id="comment" cols="30" rows="5" class="form-control"></textarea>
        </div>

        <button class="btn btn-outline-dark">Submit</button>

      </form>
      <h3 class="mt-4">All Reviews</h3>

      <div class="row">
        <% if (listing.reviews.length===0) { %>
          <p>No reviews yet 😢</p>
          <% } %>

            <% for (let review of listing.reviews) { %>
              <div class="col-6 mb-3">
                <div class="card review-card shadow-sm">
                  <div class="card-body">

                    <!-- User name -->
                    <h6 class="card-subtitle mb-2 text-muted">
                      👤 Kiran Mithapara
                    </h6>

                    <!-- Stars -->
                    <div class="mb-2">
                      <% for(let i=0; i < review.rating; i++) { %>
                        <span class="star">★</span>
                        <% } %>
                    </div>

                    <!-- Comment -->
                    <p class="card-text">
                      <%= review.comment %>
                    </p>

                    <form action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE" method="POST">

                      <button class="btn btn-sm btn-danger mt-2">Delete</button>
                    </form>
                  </div>
                </div>
              </div>
              <% } %>
      </div>
    </div>
  </div>